# Example environment configuration for smallgameagent
# Copy this file to .env and fill in your actual API keys.
# .env is gitignored and will NOT be committed.

# ------------------------------------------------------------------
# Cloud API providers (pick one via CLOUD_PROVIDER)
# ------------------------------------------------------------------

# OpenCodeGo / MiMo v2.5
# MultiProviderClient uses OPENCODEGO_*; OpenCodeGoClient legacy uses OPENCODE_*.
export OPENCODEGO_API_KEY=sk-...
export OPENCODEGO_BASE_URL=https://opencode.ai/zen/go/v1
export OPENCODE_API_KEY=sk-...
export OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Kimi
export KIMI_API_KEY=sk-...
export KIMI_BASE_URL=https://api.kimi.com/coding

# DeepSeek
export DEEPSEEK_API_KEY=sk-...
export DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiMo (xiaomi provider)
export XIAOMI_API_KEY=sk-...
export XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1

# Qwen
export QWEN_API_KEY=sk-...
export QWEN_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Default provider selection (opencodego | kimi | deepseek | xiaomi | qwen)
export CLOUD_PROVIDER=opencodego
export CLOUD_MODEL=mimo-v2.5

# ------------------------------------------------------------------
# Playwright / browser settings
# ------------------------------------------------------------------

# Headless Cocos/WebGL on WSL2 needs software rendering flags.
# Use the Playwright bundled Chromium (system chromium often crashes with swiftshader).
PLAYWRIGHT_CHROMIUM_PATH=/home/azuma/.cache/ms-playwright/chromium-1228/chrome-linux64/chrome
export PLAYWRIGHT_CHROMIUM_ARGS="--enable-unsafe-swiftshader --in-process-gpu"
